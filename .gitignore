.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
data/bronze/*
data/silver/*
data/gold/*
data/quarantine/*
!data/**/.gitkeep
artifacts/*
models/*
mlruns/
*.duckdb
*.db
*.sqlite*
